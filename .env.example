# ============================================================
# LakshyaTrack Environment Configuration Template
# Copy this file to .env and fill in your actual values
# ============================================================

# ─────────────────────────────────────────────────────────────
# BACKEND CONFIGURATION (FastAPI)
# ─────────────────────────────────────────────────────────────

# Environment: development | production
APP_ENV=development

# Database
# For local development, you can use SQLite (default)
# For production, use PostgreSQL (e.g., Supabase)
DATABASE_URL=sqlite:///./backend/sql_app.db

# MongoDB Atlas (for AI caching, idempotency, job queue)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net
MONGODB_DB_NAME=ai_career_platform

# Supabase (for OAuth integration and optional auth backend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_DAYS=30

# External AI APIs
OPENAI_API_KEY=sk-your-openai-key
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=gsk-your-groq-key
YOUTUBE_API_KEY=your-youtube-api-key

# Cloudinary (for media storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_URL=cloudinary://your-url

# Google OAuth (for audience validation)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Email (SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
FROM_EMAIL=noreply@yourdomain.com

# Admin System
# Comma-separated list of emails that have permanent black_admin access
BLACK_ADMIN_EMAILS=admin@example.com

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Redis (optional, for rate limiting and job queue)
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────
# FRONTEND CONFIGURATION (Vite)
# ─────────────────────────────────────────────────────────────

# Backend API URL
VITE_API_URL=http://localhost:8000/api/v1

# Supabase (for Google OAuth)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Application URL (for OAuth callbacks)
VITE_PUBLIC_APP_URL=http://localhost:5173
VITE_SITE_URL=http://localhost:5173
VITE_APP_URL=http://localhost:5173
