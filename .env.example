# ============================================================
# LakshyaTrack Environment Configuration Template
# Copy this file to .env and fill in your actual values
# ============================================================

# ─────────────────────────────────────────────────────────────
# BACKEND CONFIGURATION (FastAPI)
# ─────────────────────────────────────────────────────────────

# Environment: development | production
APP_ENV=development

# Database
# Local development (run uvicorn from the backend/ directory):
DATABASE_URL=sqlite:///./sql_app.db
# Production MUST use PostgreSQL (e.g. Supabase) and is rejected otherwise.

# MongoDB Atlas (for AI caching, idempotency, job queue)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net
MONGODB_DB_NAME=ai_career_platform

# Supabase (for OAuth integration and optional auth backend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-a-random-64-character-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# External AI APIs
OPENAI_API_KEY=sk-your-openai-key
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=gsk-your-groq-key
YOUTUBE_API_KEY=your-youtube-api-key

# Cloudinary (for media storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_URL=cloudinary://your-url

# Google OAuth (for audience validation)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Email (SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
FROM_EMAIL=noreply@yourdomain.com

# Admin System
# Comma-separated list of emails that have permanent black_admin access
BLACK_ADMIN_EMAILS=admin@example.com

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Redis (optional, for rate limiting and job queue)
REDIS_URL=redis://localhost:6379

# Payments (demo mode must be false in production; production verification
# is disabled until a real gateway integration is implemented)
PAYMENTS_DEMO_MODE=true

# Security / operations
ENABLE_API_DOCS=false
SANDBOX_ALLOW_UNSAFE_FALLBACK=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=auto
RATE_LIMIT_GLOBAL_PER_MINUTE=12000
RATE_LIMIT_IP_PER_MINUTE=2400
AUTH_RATE_LIMIT_PER_MINUTE=30
# Set true only behind a proxy that overwrites X-Forwarded-For (Vercel does).
TRUST_PROXY_HEADERS=false
MAX_REQUEST_BODY_BYTES=52428800

# ─────────────────────────────────────────────────────────────
# FRONTEND CONFIGURATION (Vite)
# ─────────────────────────────────────────────────────────────

# Backend API URL
VITE_API_URL=http://localhost:8000/api/v1

# Supabase (for Google OAuth)
# Only the public anon key belongs in VITE_ variables.
# NEVER place the service-role/secret key in any VITE_ variable.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Application URL (for OAuth callbacks)
VITE_PUBLIC_APP_URL=http://localhost:5173
VITE_SITE_URL=http://localhost:5173
VITE_APP_URL=http://localhost:5173
