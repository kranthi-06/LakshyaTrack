{
    "version": 2,
    "builds": [
        {
            "src": "api/index.py",
            "use": "@vercel/python",
            "config": {
                "includeFiles": [
                    "backend/app/**"
                ]
            }
        },
        {
            "src": "frontend/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.py"
        },
        {
            "source": "/assets/(.*)",
            "destination": "/frontend/assets/$1"
        },
        {
            "source": "/(lakshyatrack\\.svg|favicon\\.ico|favicon-16\\.png|favicon-32\\.png|favicon-wide\\.png|favicon\\.svg|favicon-tab\\.svg|apple-touch-icon\\.png|vite\\.svg|robots\\.txt|sitemap\\.xml)",
            "destination": "/frontend/$1"
        },
        {
            "source": "/((?!api/|frontend/).*)",
            "destination": "/frontend/index.html"
        }
    ],
    "headers": [
        {
            "source": "/((?!api/).*)",
            "headers": [
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "X-Frame-Options", "value": "DENY" },
                { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
                { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=()" },
                { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: data: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://cdn.jsdelivr.net https://tessdata.projectnaptha.com https://api.cloudinary.com; worker-src 'self' blob: https://cdn.jsdelivr.net; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
                }
            ]
        }
    ],
    "env": {
        "PYTHONPATH": "backend"
    }
}
