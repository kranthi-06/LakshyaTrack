{
    "version": 2,
    "builds": [
        {
            "src": "api/index.py",
            "use": "@vercel/python",
            "config": {
                "includeFiles": [
                    "backend/app/**"
                ]
            }
        },
        {
            "src": "frontend/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.py"
        },
        {
            "source": "/assets/(.*)",
            "destination": "/frontend/assets/$1"
        },
        {
            "source": "/(lakshyatrack\\.svg|favicon\\.ico|favicon-16\\.png|favicon-32\\.png|favicon-wide\\.png|favicon\\.svg|favicon-tab\\.svg|apple-touch-icon\\.png|vite\\.svg|robots\\.txt|sitemap\\.xml)",
            "destination": "/frontend/$1"
        },
        {
            "source": "/((?!api/|frontend/).*)",
            "destination": "/frontend/index.html"
        }
    ],
    "env": {
        "PYTHONPATH": "backend"
    }
}
