{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "version": 2,
    "installCommand": "cd frontend && npm ci",
    "buildCommand": "cd frontend && npm run build",
    "outputDirectory": "frontend/dist",
    "functions": {
        "api/index.py": {
            "includeFiles": "backend/app/**",
            "excludeFiles": "{backend/**/__pycache__/**,backend/**/*.pyc,backend/migrations/**,backend/*.sql,backend/*.db,backend/*.log,backend/error.txt,backend/err.log,backend/test_*.py,backend/*_test.py}"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.py"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "env": {
        "PYTHONPATH": "backend"
    }
}
