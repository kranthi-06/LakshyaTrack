# Ignore local environments
venv/
.venv/
node_modules/
frontend/node_modules/
backend/venv/
backend/.venv/

# Ignore local databases and logs
*.db
backend_error.log
*.log
*.backup

# Local diagnostics, generated reports, and load-test output are not runtime
# dependencies and must not be uploaded with deployments.
output/
tmp/
.pytest_cache/
backend/.pytest_cache/
*_REPORT.md
*_result*.txt
backend/results_*.txt
backend/optimized_results.txt
backend/load_*.txt
verify_all_connections.py
backend/create_*.py
backend/fix_*.py
backend/get_otp.py
backend/migrate_sqlite*.py
backend/seed_admin.py

# Ignore local IDE settings
.vscode/
.idea/

# Ignore build artifacts that we don't need Vercel to see twice
frontend/dist/
dist/

# Ignore specific large scripts if they aren't part of the app
check_users.py
debug_db.py
find_region.py
scan_*.py
inspect_schema.py
test_*.py
*.bat
docker-compose.yml
Dockerfile
